== WOE-IV变量筛选

```python
def calculate_woe_iv(df, var, target, bins=5, is_continuous=True):
    df = df.copy()
    if is_continuous:
        df["bin"] = pd.qcut(df[var], q=bins, duplicates="drop")
    else:
        df["bin"] = df[var].astype(str)
    grouped = df.groupby("bin").agg(
        Good=(target, lambda x: (x==0).sum()),
        Bad=(target, lambda x: (x==1).sum()))
    # 拉普拉斯平滑
    grouped["Good_adj"] = grouped["Good"] + 0.5
    grouped["Bad_adj"] = grouped["Bad"] + 0.5
    total_good = grouped["Good_adj"].sum()
    total_bad = grouped["Bad_adj"].sum()
    grouped["WOE"] = np.log(
        (grouped["Good_adj"]/total_good) /
        (grouped["Bad_adj"]/total_bad))
    grouped["IV_part"] = (
        grouped["Good_adj"]/total_good -
        grouped["Bad_adj"]/total_bad) * grouped["WOE"]
    return grouped, grouped["IV_part"].sum()
```

